{
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["no changes", "minor changes", "major changes", "clarification needed"]
    },
    "summary": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": { "type": "string", "enum": ["major", "minor"] },
          "area": { "type": "string", "enum": ["methods", "numbers", "code", "interpretation"] },
          "location": { "type": "string" },
          "problem": { "type": "string" },
          "consequence": { "type": "string" },
          "fix": { "type": "string" },
          "verified": { "type": "boolean" }
        },
        "required": ["severity", "area", "location", "problem", "consequence", "fix", "verified"],
        "additionalProperties": false
      }
    },
    "needs_code_run": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["decision", "summary", "issues", "needs_code_run"],
  "additionalProperties": false
}
